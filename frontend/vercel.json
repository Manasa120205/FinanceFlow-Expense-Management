{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://pennyflow-api.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://pennyflow-api.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
