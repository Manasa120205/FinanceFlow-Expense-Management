# ===================================================
# FinanceFlow Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to Git!
# ===================================================

# Database Configuration
# For PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql://financeflow_user:financeflow_secure_password@localhost:5432/financeflow_db
# For Local Development / Testing fallback (SQLite):
DATABASE_URL=sqlite:///./financeflow.db

# JWT Security
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_32_character_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment & URLs
ENVIRONMENT=development
PROJECT_NAME="FinanceFlow API"
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated list for production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Frontend Vite Configuration (placed in frontend/.env if needed)
VITE_API_URL=http://localhost:8000/api/v1
