# ===================================================
# PennyFlow Environment Configuration Template
# Copy this file to .env and provide your environment values.
# DO NOT commit real secrets or production credentials to Git!
# ===================================================

# Database Configuration
# Production (PostgreSQL - e.g. Neon, Supabase, Render, Railway):
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Local Development (SQLite fallback):
DATABASE_URL=sqlite:///./financeflow.db

# JWT Security
# Generate a strong 32+ character key in production (e.g., openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment & Branding
ENVIRONMENT=production
PROJECT_NAME="PennyFlow API"
BACKEND_URL=https://pennyflow-in.vercel.app
FRONTEND_URL=https://pennyflow-in.vercel.app

# CORS Origins (comma-separated or JSON list of allowed frontend domains)
CORS_ORIGINS=["https://pennyflow-in.vercel.app","http://localhost:5173"]

# Frontend API Base URL (leave blank if deploying API serverlessly on same Vercel domain)
VITE_API_URL=
